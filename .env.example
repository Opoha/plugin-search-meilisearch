# Meilisearch search provider plugin (Phase 4 A-04/A-05) — no secrets committed.

# Meilisearch instance URL (default matches local `docker run getmeili/meilisearch`).
OPOHA_MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API key (master key or a scoped search/admin key). Leave unset in
# local dev if Meilisearch has no key configured; never commit a real value.
# OPOHA_MEILISEARCH_API_KEY=replace-with-a-meilisearch-key

# Index name prefix — the plugin indexes products at `${prefix}_products`.
OPOHA_MEILISEARCH_INDEX_PREFIX=opoha

# Enable/disable without unregistering the plugin.
OPOHA_MEILISEARCH_ENABLED=true
